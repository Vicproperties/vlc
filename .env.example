# -----------------------------------------------------------------------------
# Environment variables — names only. Never commit real values.
# Copy to .env.local for development. Configure production values in Vercel.
# Development and production use SEPARATE Supabase projects and keys.
# -----------------------------------------------------------------------------

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL of the admin area (path today; can become a subdomain later)
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:3000/admin

# Supabase (safe to expose: protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (bypasses RLS) — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Supabase CLI only (never used by the app at runtime, never set in Vercel)
# Session pooler connection string, password URL-encoded, no brackets.
SUPABASE_DB_URL=
# Personal access token (Account -> Access Tokens) for type generation.
SUPABASE_ACCESS_TOKEN=

# Email (Resend) — SERVER ONLY
RESEND_API_KEY=
EMAIL_FROM=

# Admin OTP — SERVER ONLY. Long random string (min 32 chars).
ADMIN_OTP_HMAC_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

{
  "name": "vicsproperties",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "db:push": "node scripts/with-env.mjs supabase db push --db-url {SUPABASE_DB_URL}",
    "db:push:dry": "node scripts/with-env.mjs supabase db push --db-url {SUPABASE_DB_URL} --dry-run",
    "db:types": "node scripts/with-env.mjs supabase gen types typescript --project-id tcfpnbliwjlinwlgzmkc --schema public > src/types/database.ts",
    "test:rls": "vitest run --config vitest.integration.config.mts",
    "admin:bootstrap": "node scripts/create-first-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-youtube": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.67.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
